{
  "name": "@platforma-open/soedinglab.software-mmseqs2",
  "version": "1.17.0",
  "description": "Soedinglab MMseqs2 software package for Platforma Backend",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build": "pl-pkg build",
    "prepublishOnly": "pl-pkg prepublish"
  },
  "files": [
    "dist/"
  ],
  "block-software": {
    "entrypoints": {
      "main": {
        "docker": {
          "artifact": {
            "type": "docker",
            "dockerfile": "Dockerfile",
            "context": "./dld/mmseqs2-linux-x64"
          },
          "cmd": ["mmseqs"]
        },
        "binary": {
          "artifact": {
            "registry": "platforma-open",
            "type": "binary",
            "roots": {
              "linux-x64": "./dld/mmseqs2-linux-x64",
              "linux-aarch64": "./dld/mmseqs2-linux-aarch64",
              "macosx-x64": "./dld/mmseqs2-macosx-x64",
              "macosx-aarch64": "./dld/mmseqs2-macosx-aarch64",
              "windows-x64": "./dld/mmseqs2-windows-x64"
            }
          },
          "cmd": ["{pkg}/bin/mmseqs"]
        }
      }
    }
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@platforma-sdk/package-builder": "^3.2.3",
    "@changesets/cli": "^2.27.10"
  }
}
